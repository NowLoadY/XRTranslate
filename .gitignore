# Project specific runtime/build folders
.env
.env.*
*.env
!.env.example
!.env.sample
# Local user options, account credentials/browser sessions, and generated media.
# Shared defaults in config.json remain tracked; personal overrides live here.
runtime/
data-directory.txt
# Manually created local editor access marker; never ship or track it.
**/runtime/debug.md
/models/
target/
**/target/
*-target/
dist/
backups/
# Optional large runtime bundles used only for offline installers.
/third_party/llama.cpp/*.zip

# Rust build artifacts
*.pdb
*.dll
*.exe
*.d
!rust-client/resources/bin/mpv-2.zip

# IDE and OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Logs and databases
*.log
*.sqlite3

# Audio cache / Temporary files
*.wav
*.mp3
!plugin-src/guide/assets/audio/**/*.mp3
!rust-client/resources/companion/**/*.mp3
# Narration authoring is local tooling, separate from shipped playback.
/apps/xrtranslate-backend/examples/guide_audio*.rs
*.flac
*.ogg
# Curated built-in references are source assets, not personal audio caches.
!/crates/xrtranslate-assets/resources/voices/*/reference.wav
.temp/
*.tmp
*.bak
__pycache__/

# Third party reference repositories
third_party/Audio8_TTS/

# Local research, design drafts, and validation notes
deepthink/

# Independently maintained private plugin sources; never part of the host build.
/private-plugins/
# Installed plugins; public source lives in plugin-src/.
/plugins/

# Local demo files
/tools/demos/local/

# Android local configuration and generated output
/android/.gradle/
/android/**/build/
/android/local.properties
/android/.cxx/
# Local signing credentials and private keys
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Hidden directories are opt-in; keep only established project configuration.
.*/
!/.cargo/
!/.github/
!/third_party/MeloTTS/.github/
