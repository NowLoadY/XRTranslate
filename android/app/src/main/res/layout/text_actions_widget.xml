<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/text_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/text_widget_face" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/text_action_title" android:textColor="#303030" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <TextView android:id="@+id/widget_write" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:background="@drawable/text_widget_button" android:gravity="center" android:text="@string/text_action_write"
            android:textColor="#303030" android:textSize="14sp" android:maxLines="2" android:padding="4dp" />
        <TextView android:id="@+id/widget_clipboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:background="@drawable/text_widget_button" android:gravity="center"
            android:text="@string/text_action_clipboard" android:textColor="#303030" android:textSize="14sp" android:maxLines="2" android:padding="4dp" />
    </LinearLayout>
</LinearLayout>
