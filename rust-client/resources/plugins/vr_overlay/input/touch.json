{
  "controller_type": "oculus_touch",
  "description": "Right controller presses the left-wrist review buttons.",
  "name": "XRTranslate spatial voice",
  "bindings": {
    "/actions/voice": {
      "poses": [
        {
          "output": "/actions/voice/in/hand",
          "path": "/user/hand/left/pose/openxr_grip"
        },
        {
          "output": "/actions/voice/in/hand",
          "path": "/user/hand/right/pose/openxr_grip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/voice/out/touch",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/voice/out/touch",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}
