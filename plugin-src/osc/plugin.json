{
  "bundle_with_host": true,
  "id": "osc",
  "version": "0.1.0",
  "min_host_version": "0.4.0",
  "title": {
    "en": "VRChat OSC",
    "zh": "VRChat OSC"
  },
  "executable": "xrt-osc",
  "page": true,
  "icon": "assets/icon.svg",
  "navigation_order": 200,
  "requires": [
    "udp.configure",
    "udp.send",
    "text.action"
  ],
  "subscriptions": [
    "translation.output",
    "host.services",
    "system.metrics",
    "osc.receiver",
    "plugin.state",
    "lyrics.text",
    "voice.review",
    "udp.revoked"
  ],
  "tools": [
    {
      "name": "osc.voice",
      "description": "Prepare or send reviewed speech through the chatbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "prepare",
              "publish",
              "result"
            ]
          },
          "text": {
            "type": "string"
          },
          "operation": {
            "type": "integer"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  ],
  "navigation_group": "games"
}
