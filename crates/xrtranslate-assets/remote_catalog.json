        {
          "capability": "translation",
          "defaults": {
            "api_key": "",
            "context_window_tokens": 8192,
            "max_tokens": 512,
            "model": "gpt-4o-mini",
            "parallel_slots": 2,
            "connector": "openai-chat",
            "url": "https://api.openai.com/v1/chat/completions"
